{
  "name": "verydirtyrss",
  "version": "1.6.0",
  "description": "A simple way of transforming HTML pages into RSS feeds.",
  "type": "module",
  "scripts": {
    "start": "node dist/index.js",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npx playwright test",
    "dev": "NODE_ENV=development concurrently \"tsc --watch\" \"nodemon --watch 'src/**/*.ts' --exec 'node --loader ts-node/esm' src/index.ts\"",
    "docker:build": "docker build -t verydirtyrss .",
    "docker:run": "docker run -p 3000:3000 verydirtyrss",
    "docker:dev": "docker run -p 3000:3000 -v $(pwd)/src:/app/src verydirtyrss",
    "compose:up": "docker-compose up -d",
    "compose:down": "docker-compose down",
    "compose:logs": "docker-compose logs -f"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "axios": "^1.6.2",
    "cheerio": "^1.0.0-rc.12",
    "express": "^4.18.2",
    "jsdom": "^29.1.1",
    "pino": "^10.3.1",
    "rss": "^1.2.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@types/express": "^4.17.21",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^20.10.6",
    "@types/rss": "^0.0.32",
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.2",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "vitest": "^4.1.5"
  }
}
